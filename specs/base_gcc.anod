from e3.anod.loader import spec


class base_gcc(spec("binary_install")):
    @property
    def version(self):
        return "16.0.0-20251102"

    @property
    def tarball(self):
        return "gnat-%s-%s.tar.gz" % (self.env.platform, self.version)

    @property
    def url(self):
        return (
            "https://github.com/reznikmm/GNAT-FSF-builds/releases/download/%s/%s"
            % (self.version, self.tarball)
        )
